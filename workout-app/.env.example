# Where the app should reach the backup API.
#
# The web build talks to its own origin and ignores this. A phone needs an
# absolute URL; leaving this unset falls back to the production deployment in
# src/api/client.ts.
EXPO_PUBLIC_API_URL=https://workout-app-two-orpin.vercel.app

# Server side only -- set in the Vercel project, never committed.
# POSTGRES_URL=postgres://user:password@host/database
